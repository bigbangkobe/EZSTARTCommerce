generator client {
  provider = "prisma-client"
  output = "./src/generated"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  displayName String
  locale String
  status String @default("active")
  passwordHash String
  mfaRequired Boolean @default(true)
  version Int @default(1)
  lastLoginAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  invitation AdminInvitation? @relation("InvitationTarget")
  invitationsSent AdminInvitation[] @relation("InvitationIssuer")
  passwordReset AdminPasswordReset? @relation("PasswordResetTarget")
  roles AdminUserRole[]
  factor MfaFactor?
  recoveryCodes RecoveryCode[]
  sessions AdminSession[]
  challenges AdminChallenge[]
  privacyVerifications CustomerPrivacyRequest[] @relation("PrivacyVerifier")
  privacyOwned CustomerPrivacyRequest[] @relation("PrivacyOwner")
  privacyReviewed CustomerPrivacyRequest[] @relation("PrivacyReviewer")
}

model AdminRole {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  kind String
  /// 默认岗位权限包的稳定标识；自定义角色为 null，预设角色改名后仍可识别。
  presetKey String? @unique
  description String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  permissionCodes String[]
  version Int @default(1)
  users AdminUserRole[]
}

model AdminUserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  role AdminRole @relation(fields:[roleId], references:[id], onDelete:Restrict)
  @@id([userId,roleId])
}

model BootstrapState {
  id Int @id
  tokenDigest String @unique
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
}

model AdminChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  purpose String
  tokenDigest String @unique
  factorVersion Int
  userVersion Int
  failures Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  enrollmentId String? @unique @db.Uuid
  pendingSecret String?
  @@index([expiresAt])
}

model MfaFactor {
  userId String @id @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  encryptedSecret String
  version Int @default(1)
  lastUsedStep BigInt @default(-1)
}

model RecoveryCode {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  digest String @unique
  consumedAt DateTime? @db.Timestamptz(3)
}

model AdminSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  tokenDigest String @unique
  mfaVerified Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  idleExpiresAt DateTime @db.Timestamptz(3)
  absoluteExpiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([userId,revokedAt])
}

model IdentityRateLimit {
  key String @id
  count Int @default(0)
  windowStart DateTime @db.Timestamptz(3)
  blockedUntil DateTime? @db.Timestamptz(3)
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String
  objectId String?
  result String
  requestId String
  reason String?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([occurredAt])
}

model AdminInvitation {
  id String @id @db.Uuid
  userId String @unique @db.Uuid
  user AdminUser @relation("InvitationTarget", fields: [userId], references: [id], onDelete: Restrict)
  inviterId String @db.Uuid
  inviter AdminUser @relation("InvitationIssuer", fields: [inviterId], references: [id], onDelete: Restrict)
  version Int @default(1)
  status String @default("pending")
  tokenDigest String @unique
  expiresAt DateTime @db.Timestamptz(3)
  lastSentAt DateTime @db.Timestamptz(3)
  sendWindowStartedAt DateTime @db.Timestamptz(3)
  sendsInWindow Int
  notificationJobId String? @db.Uuid
  resendReceipts Json @default("{}")
  notificationJobs IdentityNotificationJob[]
}

model AdminPasswordReset {
  id String @id @db.Uuid
  userId String @unique @db.Uuid
  user AdminUser @relation("PasswordResetTarget", fields: [userId], references: [id], onDelete: Restrict)
  version Int @default(1)
  status String @default("pending")
  tokenDigest String @unique
  expiresAt DateTime @db.Timestamptz(3)
  requestedAt DateTime @db.Timestamptz(3)
  notificationJobId String? @db.Uuid
  notificationJobs IdentityNotificationJob[]
}

// One queue row per deliverable secret. Exactly one target reference is set;
// the database enforces that pairing with a CHECK constraint in the migration.
model IdentityNotificationJob {
  id String @id @db.Uuid
  kind String @default("invitation")
  invitationId String? @db.Uuid
  passwordResetId String? @db.Uuid
  /// 会员验证码任务绑定到挑战行；与 kind 由数据库 CHECK 严格配对（不建 Prisma 关联，避免双向外键循环）。
  otpChallengeId String? @db.Uuid
  targetVersion Int
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  lastErrorCode String?
  sentAt DateTime? @db.Timestamptz(3)
  invitation AdminInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  passwordReset AdminPasswordReset? @relation(fields: [passwordResetId], references: [id], onDelete: Restrict)
  /// 自检邮件的收件人掩码：明文只在密文里，发送成功后密文销毁，掩码留作记录。
  maskedTarget String?
  encryptedPayload String?
  expiresAt DateTime @db.Timestamptz(3)
  status String @default("pending")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([status, expiresAt])
  @@index([status, availableAt, leaseExpiresAt])
}

// 单实例单店铺：id 固定为 1，用 CHECK 约束在数据库层阻止第二个店铺行。
model StoreConfig {
  id Int @id @default(1)
  displayName String
  locales String[]
  defaultLocale String
  baseCurrency String
  timezone String
  featureFlags Json @default("{}")
  logoMediaId String? @db.Uuid
  logoMedia MediaAsset? @relation("StoreLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  faviconMediaId String? @db.Uuid
  faviconMedia MediaAsset? @relation("StoreFavicon", fields: [faviconMediaId], references: [id], onDelete: Restrict)
  /// 首次产生真实交易后锁定基础币种，避免历史订单与本位币不一致。
  tradingStartedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  markets MarketProfile[]
  reviews MarketReviewRecord[]
}

model MarketProfile {
  id String @id @default(uuid()) @db.Uuid
  marketCode String @unique
  enabled Boolean @default(false)
  eligibleProductIds String[] @db.Uuid
  reviewStatus String @default("pending")
  reviewValidUntil DateTime? @db.Timestamptz(3)
  storeConfigId Int @default(1)
  storeConfig StoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// 审核是追加历史：记录客户提供的依据，不做法规判断，也不能被改写。
model MarketReviewRecord {
  id String @id @default(uuid()) @db.Uuid
  storeConfigId Int @default(1)
  storeConfig StoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  marketCode String
  decision String
  evidenceReference String
  reason String
  reviewedBy String @db.Uuid
  reviewedAt DateTime @db.Timestamptz(3)
  validUntil DateTime? @db.Timestamptz(3)
  storeConfigVersion Int
  @@index([marketCode, reviewedAt])
}

// ---- 商品目录（M03）---------------------------------------------------------
// 多语言按翻译实体管理；金额为整数最小货币单位并带币种；SKU 全店唯一。
// 图片只保存媒体引用与顺序，媒体对象本身由媒体模块（M02）管理。

// 媒体（M02）：对象存储保存二进制，这里只保存元数据与校验摘要。
// status 在确认上传前为 pending，确认并核对摘要后转 ready；前台只读 ready。
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  objectKey String @unique
  contentType String
  sizeBytes Int
  /// 摘要与尺寸在确认上传后写入；pending 行允许为空。
  sha256 String?
  width Int?
  height Int?
  originalFileName String
  status String @default("pending")
  uploadedBy String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  productMedia ProductMedia[]
  brands Brand[]
  storeLogos StoreConfig[] @relation("StoreLogo")
  storeFavicons StoreConfig[] @relation("StoreFavicon")
  @@index([status, createdAt])
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  position Int @default(0)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  translations CategoryTranslation[]
  products ProductCategory[]
}

model CategoryTranslation {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale String
  name String
  slug String?
  description String?
  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model Brand {
  id String @id @default(uuid()) @db.Uuid
  logoMediaId String? @db.Uuid
  logoMedia MediaAsset? @relation(fields: [logoMediaId], references: [id], onDelete: Restrict)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  translations BrandTranslation[]
  products Product[]
}

model BrandTranslation {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locale String
  name String
  slug String?
  description String?
  @@unique([brandId, locale])
  @@unique([locale, slug])
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  status String @default("draft")
  baseSku String?
  brandId String? @db.Uuid
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  taxClassRef String?
  marketCodes String[]
  /// 未来时间表示定时发布；status 仍为 draft，直到发布时刻生效。
  publishedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  translations ProductTranslation[]
  variants ProductVariant[]
  media ProductMedia[]
  attributes ProductAttribute[]
  categories ProductCategory[]
  @@index([status, createdAt])
}

model ProductTranslation {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale String
  name String
  slug String
  shortDescription String?
  description String?
  seoTitle String?
  seoDescription String?
  @@unique([productId, locale])
  @@unique([locale, slug])
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku String @unique
  optionValues Json
  priceMinor Int
  compareAtMinor Int?
  currency String
  status String @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  inventory InventoryItem?
  threshold InventoryThreshold?
  cartItems CartItem[]
  quoteLines CheckoutQuoteLine[]
  orderItems OrderItem[]
  reservations InventoryReservation[]
  inventoryMovements InventoryMovement[]
}

model ProductMedia {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId String @db.Uuid
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position Int
  altByLocale Json @default("{}")
  @@unique([productId, mediaId])
}

model ProductAttribute {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  code String
  value String
  @@unique([productId, code])
}

model ProductCategory {
  productId String @db.Uuid
  categoryId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@id([productId, categoryId])
}

// 库存先只保存数量，变更流水由 M12 引入；当前没有写入库存的接口。
model InventoryItem {
  id String @id @default(uuid()) @db.Uuid
  variantId String @unique @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand Int @default(0)
  reserved Int @default(0)
  /// 人工调整与并发操作的版本凭据；退款/发货等服务端动作也会推进它。
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ---- 购物车与结账（M06）-----------------------------------------------------
// 游客购物袋只认 cookie 里的随机 token：库里存摘要，泄库也拿不到可用 token。
// 报价是不可变快照，行数据与联系/地址/配送快照一起冻结，下单只认报价版本。

model GuestCart {
  id String @id @default(uuid()) @db.Uuid
  tokenDigest String @unique
  status String @default("active")
  currency String
  marketCode String?
  locale String?
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items CartItem[]
  quotes CheckoutQuote[]
  orders ShopOrder[]
  analyticsSessions AnalyticsSession[]
  @@index([status, expiresAt])
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart GuestCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([cartId, variantId])
}

// 配送区按国家/区域划分；费率绑定到区，首期只支持固定费与金额门槛免邮。
model ShippingZone {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  nameByLocale Json
  countryCodes String[]
  regionCodes String[]
  priority Int @default(0)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  rates ShippingRateZone[]
}

model ShippingRate {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  nameByLocale Json
  fixedFeeMinor Int
  freeAboveMinor Int?
  currency String
  estimatedMinDays Int?
  estimatedMaxDays Int?
  codEnabled Boolean @default(false)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  zones ShippingRateZone[]
  orders ShopOrder[]
}

model ShippingRateZone {
  rateId String @db.Uuid
  zoneId String @db.Uuid
  rate ShippingRate @relation(fields: [rateId], references: [id], onDelete: Cascade)
  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  @@id([rateId, zoneId])
}

model CheckoutQuote {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart GuestCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  status String @default("active")
  version Int @default(1)
  locale String
  marketCode String
  currency String
  contact Json
  shippingAddress Json
  shippingMethodId String @db.Uuid
  shippingMethodSnapshot Json
  subtotalMinor Int
  discountMinor Int
  shippingMinor Int
  taxMinor Int
  totalMinor Int
  pointsRequested Int @default(0)
  pointsRedeemed Int @default(0)
  pointsValueMinor Int @default(0)
  pointsMemberId String? @db.Uuid
  pointsRuleVersion String?
  couponId String? @db.Uuid
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponSnapshot Json?
  couponCode String?
  couponSummary Json?
  /// 报价时冻结的顾客限额键：会员走 memberId 摘要、访客走联系方式摘要；下单原样沿用。
  couponCustomerKey String?
  ruleVersions Json
  warnings Json
  policyAcceptances Json
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lines CheckoutQuoteLine[]
  order ShopOrder?
  @@index([cartId, status])
}

model CheckoutQuoteLine {
  id String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  quote CheckoutQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sku String
  productName String
  variantName String?
  quantity Int
  unitPriceMinor Int
  lineSubtotalMinor Int
  lineDiscountMinor Int
  lineTotalMinor Int
  @@unique([quoteId, variantId])
}

// 订单只由报价生成：金额、联系、地址、配送、优惠全部来自快照，不接受客户端金额。
model ShopOrder {
  id String @id @default(uuid()) @db.Uuid
  publicOrderNumber String @unique
  idempotencyKey String @unique
  requestDigest String
  quoteId String @unique @db.Uuid
  quote CheckoutQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  cartId String? @db.Uuid
  cart GuestCart? @relation(fields: [cartId], references: [id], onDelete: SetNull)
  shippingRateId String? @db.Uuid
  shippingRate ShippingRate? @relation(fields: [shippingRateId], references: [id], onDelete: Restrict)
  orderStatus String
  paymentStatus String
  fulfillmentStatus String @default("unfulfilled")
  currency String
  subtotalMinor Int
  discountMinor Int
  shippingMinor Int
  taxMinor Int
  totalMinor Int
  pointsRedeemed Int @default(0)
  pointsValueMinor Int @default(0)
  pointsMemberId String? @db.Uuid
  pointsRuleVersion String?
  locale String
  marketCode String
  contact Json
  shippingAddress Json?
  shippingMethodSnapshot Json
  couponId String? @db.Uuid
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponSnapshot Json?
  customerNote String?
  paymentMethodCode String
  policyAcceptances Json
  cancelledAt DateTime? @db.Timestamptz(3)
  cancelReasonCode String?
  cancelReason String?
  customerNotified Boolean @default(false)
  placedAt DateTime @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items OrderItem[]
  events OrderStatusEvent[]
  reservations InventoryReservation[]
  notes OrderNote[]
  actions OrderAction[]
  shipments Shipment[]
  addressChanges OrderAddressChange[]
  memberLinks OrderMemberLink[]
  payments Payment[]
  paymentEvents PaymentEvent[]
  afterSalesCases AfterSalesCase[]
  refunds Refund[]
  couponRedemption CouponRedemption?
  @@index([orderStatus, placedAt])
  @@index([placedAt])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String? @db.Uuid
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku String
  productName String
  variantName String?
  quantity Int
  unitPriceMinor Int
  lineSubtotalMinor Int
  lineDiscountMinor Int
  lineTotalMinor Int
  shipmentItems ShipmentItem[]
  afterSalesItems AfterSalesItem[]
  @@index([orderId])
}

// ---- 订单履约（M07）----------------------------------------------------------
// 状态只由显式 action 推进：备注、包裹、发货、签收各写各的记录，不给“直接改状态”的入口。
// 幂等表把后台写操作的 Idempotency-Key 落库，重放时返回同一结果而不是重复扣库存。

model OrderNote {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  note String
  authorId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

model OrderAction {
  id String @id @default(uuid()) @db.Uuid
  idempotencyKey String @unique
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action String
  requestDigest String
  objectId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId])
}

model Shipment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status String @default("created")
  carrierCode String?
  carrierName String?
  trackingNumber String?
  note String?
  dispatchedAt DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  evidenceRef String?
  carrierStatus String?
  lastCarrierEventAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items ShipmentItem[]
  carrierEvents CarrierStatusEvent[]
  @@index([orderId, createdAt])
}

model CarrierStatusEvent {
  id String @id @default(uuid()) @db.Uuid
  eventId String @unique
  shipmentId String @db.Uuid
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrierCode String
  status String
  occurredAt DateTime @db.Timestamptz(3)
  trackingNumber String?
  note String?
  signatureRef String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([shipmentId, occurredAt])
  @@index([carrierCode, occurredAt])
}

model ShipmentItem {
  id String @id @default(uuid()) @db.Uuid
  shipmentId String @db.Uuid
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String @db.Uuid
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity Int
  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model OrderAddressChange {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousAddress Json?
  newAddress Json
  shippingMinorBefore Int
  shippingMinorAfter Int
  totalMinorBefore Int
  totalMinorAfter Int
  customerConfirmationRef String?
  actorId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

// 预留与订单同事务写入：库存不足时没有任何一行能落库。
model InventoryReservation {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity Int
  status String @default("active")
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([orderId, variantId])
  @@index([status, expiresAt])
}

model OrderStatusEvent {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus String
  reason String?
  actorType String @default("customer")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

// ---- 付款（M08）--------------------------------------------------------------
// 数据库只存“凭证引用”而不是凭证本身：secretRef 必须是 secret:// / env:// 这类引用，
// 明文密钥由密钥管理服务或环境变量持有；响应里只回是否已配置与指纹。

model PaymentMethodConfig {
  id String @id @default(uuid()) @db.Uuid
  providerCode String
  environment String
  displayName String
  enabled Boolean @default(false)
  approvalReference String?
  approvedAt DateTime? @db.Timestamptz(3)
  publicConfig Json
  secretRef String?
  secretFingerprint String?
  connectionStatus String @default("unverified")
  lastCheckedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdBy String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  payments Payment[]
  @@unique([providerCode, environment])
}

// 一笔订单在每个支付渠道只有一条台账记录：dedupeKey 是“渠道:订单”的唯一键，
// 重复登记会被唯一约束挡住，而不是产生第二条入账。
model Payment {
  id String @id @default(uuid()) @db.Uuid
  publicPaymentNumber String @unique
  dedupeKey String @unique
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  methodConfigId String? @db.Uuid
  methodConfig PaymentMethodConfig? @relation(fields: [methodConfigId], references: [id], onDelete: Restrict)
  providerCode String
  environment String
  channel String
  status String @default("pending")
  amountMinor Int
  currency String
  providerTransactionId String?
  paidAt DateTime? @db.Timestamptz(3)
  returnedAt DateTime? @db.Timestamptz(3)
  reference String?
  failureCode String?
  failureMessage String?
  recordedBy String? @db.Uuid
  metadata Json
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events PaymentEvent[]
  refunds Refund[]
  @@index([orderId])
  @@index([status, createdAt])
  @@index([providerCode, providerTransactionId])
}

model PaymentEvent {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type String
  fromStatus String?
  toStatus String
  source String
  actorId String? @db.Uuid
  dedupeKey String @unique
  payload Json
  occurredAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([paymentId, occurredAt])
}

// ---- 售后与退款（M16 第一批）--------------------------------------------------
// 售后案件不改写订单/付款快照：案件只记录申请、批准与处置，退款是独立的交易记录。
// 三条数据库兜底：批准金额必须有批准时间；退款成功必须有执行时间；同一案件行不能重复入库。

model AfterSalesCase {
  id String @id @default(uuid()) @db.Uuid
  publicCaseNumber String @unique
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  caseType String
  status String @default("submitted")
  reasonCode String?
  reason String
  source String @default("admin")
  requestedRefundMinor Int?
  approvedRefundMinor Int?
  ownerId String? @db.Uuid
  approvedAt DateTime? @db.Timestamptz(3)
  approvedBy String? @db.Uuid
  rejectedAt DateTime? @db.Timestamptz(3)
  rejectedBy String? @db.Uuid
  rejectReason String?
  closedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items AfterSalesItem[]
  refunds Refund[]
  returns ReturnShipment[]
  receipts ReturnReceipt[]
  inspections InspectionRecord[]
  events AfterSalesEvent[]
  movements InventoryMovement[]
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([caseType, createdAt])
}

model AfterSalesItem {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  afterSalesCase AfterSalesCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderItemId String @db.Uuid
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  requestedQuantity Int
  approvedQuantity Int?
  amountMinor Int?
  disposition String?
  @@unique([caseId, orderItemId])
  @@index([orderItemId])
}

model Refund {
  id String @id @default(uuid()) @db.Uuid
  publicRefundNumber String @unique
  idempotencyKey String @unique
  requestDigest String
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId String @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  caseId String? @db.Uuid
  afterSalesCase AfterSalesCase? @relation(fields: [caseId], references: [id], onDelete: Restrict)
  channel String
  providerCode String
  environment String
  amountMinor Int
  currency String
  status String @default("requested")
  reasonCode String?
  reason String
  requestedBy String @db.Uuid
  approvedBy String? @db.Uuid
  executedBy String? @db.Uuid
  approvedAt DateTime? @db.Timestamptz(3)
  executedAt DateTime? @db.Timestamptz(3)
  externalRefundId String?
  reference String?
  failureCode String?
  failureMessage String?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events RefundEvent[]
  couponReturns CouponQuotaReturn[]
  @@index([orderId, createdAt])
  @@index([paymentId, status])
  @@index([status, createdAt])
  @@index([caseId])
}

model RefundEvent {
  id String @id @default(uuid()) @db.Uuid
  refundId String @db.Uuid
  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  type String
  fromStatus String?
  toStatus String
  source String
  actorId String? @db.Uuid
  dedupeKey String @unique
  payload Json
  occurredAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([refundId, occurredAt])
}

model ReturnShipment {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  afterSalesCase AfterSalesCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  carrierCode String?
  carrierName String?
  trackingNumber String?
  status String @default("in_transit")
  shippedAt DateTime? @db.Timestamptz(3)
  receivedAt DateTime? @db.Timestamptz(3)
  reference String?
  note String?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  receipts ReturnReceipt[]
  @@index([caseId, createdAt])
}

model ReturnReceipt {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  afterSalesCase AfterSalesCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  shipmentId String? @db.Uuid
  shipment ReturnShipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  receivedAt DateTime @db.Timestamptz(3)
  reference String?
  actorId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  items ReturnReceiptItem[]
  @@index([caseId, receivedAt])
}

model ReturnReceiptItem {
  id String @id @default(uuid()) @db.Uuid
  receiptId String @db.Uuid
  receipt ReturnReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItemId String @db.Uuid
  quantity Int
  @@unique([receiptId, orderItemId])
  @@index([orderItemId])
}

model InspectionRecord {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  afterSalesCase AfterSalesCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  receiptId String? @db.Uuid
  orderItemId String @db.Uuid
  quantity Int
  disposition String
  note String?
  actorId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([caseId, createdAt])
}

// 处置流水：卖得出去的才加回 onHand，其余只记录去向，库存数字不为“已处理”背书。
model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderId String? @db.Uuid
  caseId String? @db.Uuid
  afterSalesCase AfterSalesCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  type String
  quantity Int
  stockDelta Int
  onHandAfter Int?
  reason String
  reasonCode String?
  reference String?
  /// 人工调整的请求指纹：同一 Idempotency-Key 换了内容就不再是重放。
  requestFingerprint String?
  dedupeKey String @unique
  actorId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([variantId, createdAt])
  @@index([caseId])
  @@index([type, createdAt])
}

/// 低库存阈值：0 表示只关心“售罄”，阈值只影响提醒，不影响可售数量。
model InventoryThreshold {
  id String @id @default(uuid()) @db.Uuid
  variantId String @unique @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lowStockLevel Int @default(0)
  updatedBy String? @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([lowStockLevel])
}

/// 优惠券规则模板。码不可重复；规则只被报价引用，修改不影响既有订单快照。
model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  status String @default("active")
  discountType String
  discountValue Int
  currency String
  validFrom DateTime @db.Timestamptz(3)
  validUntil DateTime @db.Timestamptz(3)
  minSubtotalMinor Int?
  totalLimit Int?
  perCustomerLimit Int?
  eligibleProductIds String[] @default([]) @db.Uuid
  eligibleCategoryIds String[] @default([]) @db.Uuid
  memberTierIds String[] @default([]) @db.Uuid
  /// none = 退款不返额度；restore = 整单退款后新建返还记录，不改原核销记录。
  refundPolicy String @default("none")
  version Int @default(1)
  createdBy String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  quotes CheckoutQuote[]
  orders ShopOrder[]
  redemptions CouponRedemption[]
  batches CouponBatch[]
  @@index([status, validFrom, validUntil])
  @@index([createdAt, id])
}

/// 一张订单最多一条核销记录：下单预占，收款成功核销，取消释放，超时过期。
model CouponRedemption {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId String @unique @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status String @default("reserved")
  discountMinor Int
  currency String
  /// 实例密钥 HMAC(规范化邮箱或电话)，用于访客单顾客限额；不落原联系方式。
  customerKey String?
  codeSnapshot String
  ruleSnapshot Json
  dedupeKey String @unique
  reservedAt DateTime @default(now()) @db.Timestamptz(3)
  redeemedAt DateTime? @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events CouponRedemptionEvent[]
  quotaReturn CouponQuotaReturn?
  @@index([couponId, status])
  @@index([couponId, customerKey])
}

model CouponRedemptionEvent {
  id String @id @default(uuid()) @db.Uuid
  redemptionId String @db.Uuid
  redemption CouponRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus String
  reason String
  actorType String
  actorId String? @db.Uuid
  dedupeKey String? @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([redemptionId, createdAt, id])
}

model CouponQuotaReturn {
  id String @id @default(uuid()) @db.Uuid
  redemptionId String @unique @db.Uuid
  redemption CouponRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  refundId String? @db.Uuid
  refund Refund? @relation(fields: [refundId], references: [id], onDelete: Restrict)
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// 优惠券批量发放批次（M11 会员解锁）：先建批登记意图，复核收件人数后再确认发放。
// 名单与筛选二选一；issued 状态必须同时有确认数、发放时间与幂等键。
model CouponBatch {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  channel String
  recipientMemberIds String[] @default([]) @db.Uuid
  recipientFilter Json?
  recipientCount Int
  status String @default("pending")
  confirmedRecipientCount Int?
  templateId String? @db.Uuid
  idempotencyKey String @unique
  createdBy String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  issuedAt DateTime? @db.Timestamptz(3)
  @@unique([couponId, idempotencyKey])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model AfterSalesEvent {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  afterSalesCase AfterSalesCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type String
  fromStatus String?
  toStatus String
  note String?
  actorId String? @db.Uuid
  dedupeKey String @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([caseId, createdAt])
}

// 顾客档案（M10）：邮箱按规范化小写全店唯一，电话可空；顾客可以没有会员档案。
model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  emailNormalized String?        @unique
  phone           String?
  displayName     String
  tags            String[]       @default([])
  internalNote    String?
  status          String         @default("active")
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  member          MemberProfile?
  privacyRequests CustomerPrivacyRequest[]
  exports         CustomerDataExportJob[]
  consents        CustomerConsent[]
  @@index([createdAt])
}

// 会员档案：一个顾客最多一个会员；会员号是对外标识，不承载顾客资料。
model MemberProfile {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String            @unique @db.Uuid
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  memberNo   String            @unique
  consentRef String?
  status     String            @default("active")
  // 当前等级只是归属快照；历史等级变更靠审计留痕，规则变更不影响历史流水。
  tierId     String?           @db.Uuid
  tier       MembershipTier?   @relation(fields: [tierId], references: [id], onDelete: Restrict)
  // 累计消费用于等级解析，单位是最小货币单位；只增不减。
  lifetimeSpendMinor BigInt    @default(0)
  joinedAt   DateTime          @default(now()) @db.Timestamptz(3)
  version    Int               @default(1)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  sessions   MemberSession[]
  orderLinks OrderMemberLink[]
  pointAccount PointAccount?
  pointLedger PointLedger[]
  @@index([status])
  @@index([tierId])
}

// 邮箱 OTP 挑战：验证码只存 HMAC 摘要，邮箱只存绑定本行的 AES-GCM 密文。
model MemberOtpChallenge {
  id                String    @id @db.Uuid
  emailDigest       String
  emailCipher       String
  codeDigest        String
  locale            String
  purpose           String    @default("member_login")
  status            String    @default("pending")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  notificationJobId String?   @db.Uuid
  expiresAt         DateTime  @db.Timestamptz(3)
  verifiedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  @@index([emailDigest, createdAt])
  @@index([status, expiresAt])
}

// 会员会话：cookie 只带随机 token，库中只有 SHA-256 摘要。
model MemberSession {
  id          String        @id @default(uuid()) @db.Uuid
  memberId    String        @db.Uuid
  member      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenDigest String        @unique
  status      String        @default("active")
  expiresAt   DateTime      @db.Timestamptz(3)
  revokedAt   DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  @@index([memberId])
}

// 订单-会员关联：追加事实，不允许级联删除顾客或订单。
model OrderMemberLink {
  orderId  String        @db.Uuid
  order    ShopOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  memberId String        @db.Uuid
  member   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Restrict)
  source   String        @default("email_match")
  linkedAt DateTime      @default(now()) @db.Timestamptz(3)
  @@id([orderId, memberId])
  @@index([memberId])
}

// 店铺级积分口径（单例 id = 1）：开关、多少「分」换 1 点、积分有效期。
model LoyaltySetting {
  id                 Int      @id @default(1)
  enabled            Boolean  @default(false)
  minorPerPoint      Int      @default(100)
  pointsExpiryMonths Int?
  version            Int      @default(1)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// 会员等级：rank 决定高低且唯一；minorPerPoint 为空表示沿用店铺口径。
model MembershipTier {
  id                     String          @id @default(uuid()) @db.Uuid
  code                   String          @unique
  nameByLocale           Json
  rank                   Int             @unique
  minLifetimeSpendMinor  BigInt          @default(0)
  minorPerPoint          Int?
  benefits               Json            @default("[]")
  status                 String          @default("active")
  version                Int             @default(1)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  members                MemberProfile[]
  @@index([status, rank])
}

// 积分账户：余额与流水同事务更新，余额永不为负。
model PointAccount {
  id        String        @id @default(uuid()) @db.Uuid
  memberId  String        @unique @db.Uuid
  member    MemberProfile @relation(fields: [memberId], references: [id], onDelete: Restrict)
  balance   Int           @default(0)
  status    String        @default("active")
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
}

// 积分流水：追加式（触发器拒绝 UPDATE/DELETE），同一业务事件只能记一次账。
model PointLedger {
  id             String   @id @db.Uuid
  memberId       String   @db.Uuid
  member         MemberProfile @relation(fields: [memberId], references: [id], onDelete: Restrict)
  deltaPoints    Int
  balanceAfter   Int
  entryType      String
  sourceType     String
  sourceRef      String?
  reasonCode     String
  reason         String?
  actorId        String?  @db.Uuid
  ruleVersion    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime? @db.Timestamptz(3)
  @@index([memberId, createdAt])
  @@index([sourceType, sourceRef])
}

// 顾客资料请求（M10 第六批）：后台受理工作流。
// 未核验身份不得进入处置阶段（数据库侧有 CHECK 兜底），核验与决定都必须留人与时间。
model CustomerPrivacyRequest {
  id                      String      @id @default(uuid()) @db.Uuid
  requestNumber           String      @unique
  requestType             String
  sourceChannel           String
  requestScope            String[]    @default([])
  customerRef             String?
  customerId              String?     @db.Uuid
  customer                Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  exportJobs              CustomerDataExportJob[]
  verificationState       String      @default("pending")
  verificationMethod      String?
  verificationEvidenceRef String?
  verifiedAt              DateTime?   @db.Timestamptz(3)
  verifiedBy              String?     @db.Uuid
  verifier                AdminUser?  @relation("PrivacyVerifier", fields: [verifiedBy], references: [id], onDelete: Restrict)
  status                  String      @default("received")
  receivedAt              DateTime    @db.Timestamptz(3)
  dueAt                   DateTime    @db.Timestamptz(3)
  ownerId                 String?     @db.Uuid
  owner                   AdminUser?  @relation("PrivacyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewerId              String?     @db.Uuid
  reviewer                AdminUser?  @relation("PrivacyReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decisionAt              DateTime?   @db.Timestamptz(3)
  decisionReason          String?
  retentionExceptionRef   String?
  exportJobRef            String?
  completedAt             DateTime?   @db.Timestamptz(3)
  idempotencyKey          String?     @unique
  version                 Int         @default(1)
  createdAt               DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  @@index([status, dueAt])
  @@index([dueAt])
  @@index([receivedAt])
  @@index([customerId])
}

// 隐私请求口径：单例，只有到期天数需要店铺自己定。
model PrivacySetting {
  id        Int      @id @default(1)
  dueDays   Int      @default(30)
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// 导出工件：明文快照只以 AES-GCM 密文留存，AAD 绑任务行；到期或匿名化时销毁密文。
model CustomerDataExportJob {
  id              String                @id @db.Uuid
  requestId       String                @unique @db.Uuid
  request         CustomerPrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  customerId      String                @db.Uuid
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          String                @default("ready")
  encryptedPayload String?
  byteSize        Int
  sha256          String                @db.Char(64)
  createdAt       DateTime              @db.Timestamptz(3)
  expiresAt       DateTime              @db.Timestamptz(3)
  revokedAt       DateTime?             @db.Timestamptz(3)
  @@index([customerId])
  @@index([expiresAt])
}

// 结构化营销同意：退订是状态写入，不是删掉备注；交易通知不走这张表。
model CustomerConsent {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  channel     String
  purpose     String   @default("marketing")
  status      String
  source      String
  evidenceRef String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@unique([customerId, channel, purpose])
  @@index([customerId, status])
}

// 经营报表导出（M14）：异步任务 + 短时下载。默认不含 PII；下载 URL 只在有效期内可用。
// 导出的 CSV 是聚合结果，不含联系方式/订单明细，因此以明文存储即可（无个人资料可泄露）。
model ReportExport {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @unique
  requestedBy    String    @db.Uuid
  reportKey      String
  format         String    @default("csv")
  status         String    @default("pending")
  filters        Json
  includePii     Boolean   @default(false)
  fileName       String?
  rowCount       Int?
  errorCode      String?
  content        String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  @@index([requestedBy, createdAt])
  @@index([expiresAt])
}

// 访问漏斗（M14 第二批）：第一方匿名事件采集。sessionId 是浏览器随机生成的高熵串，
// 不来自手机号/邮箱/购物袋 token；cartId 仅在服务端读 HttpOnly cookie 后写入，用于把
// 成功订单（ShopOrder.cartId）权威地归到会话，绝不采信浏览器的 purchase 事件。
// 两张表都不存姓名/电话/邮箱/地址/完整 URL/支付凭证——schema 层面就没有这些列。
model AnalyticsSession {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @unique
  cartId       String?   @db.Uuid
  cart         GuestCart? @relation(fields: [cartId], references: [id], onDelete: SetNull)
  firstSeenAt  DateTime  @db.Timestamptz(3)
  lastSeenAt   DateTime  @db.Timestamptz(3)
  locale       String?
  deviceClass  String?
  marketCode   String?
  source       String?
  consentState String    @default("unknown")
  events       AnalyticsEvent[]
  @@index([cartId])
  @@index([firstSeenAt])
}

model AnalyticsEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique
  sessionId     String
  session       AnalyticsSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  eventName     String
  occurredAt    DateTime  @db.Timestamptz(3)
  schemaVersion String
  consentState  String
  pageKey       String?
  locale        String?
  deviceClass   String?
  marketCode    String?
  variantId     String?
  interactionId String?
  source        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  @@index([sessionId, occurredAt])
  @@index([eventName, occurredAt])
  @@index([occurredAt])
}
