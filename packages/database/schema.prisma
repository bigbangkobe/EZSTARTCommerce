generator client {
  provider = "prisma-client"
  output = "./src/generated"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  displayName String
  locale String
  status String @default("active")
  passwordHash String
  mfaRequired Boolean @default(true)
  version Int @default(1)
  lastLoginAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  invitation AdminInvitation? @relation("InvitationTarget")
  invitationsSent AdminInvitation[] @relation("InvitationIssuer")
  passwordReset AdminPasswordReset? @relation("PasswordResetTarget")
  roles AdminUserRole[]
  factor MfaFactor?
  recoveryCodes RecoveryCode[]
  sessions AdminSession[]
  challenges AdminChallenge[]
}

model AdminRole {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  kind String
  /// 默认岗位权限包的稳定标识；自定义角色为 null，预设角色改名后仍可识别。
  presetKey String? @unique
  description String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  permissionCodes String[]
  version Int @default(1)
  users AdminUserRole[]
}

model AdminUserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  role AdminRole @relation(fields:[roleId], references:[id], onDelete:Restrict)
  @@id([userId,roleId])
}

model BootstrapState {
  id Int @id
  tokenDigest String @unique
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
}

model AdminChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  purpose String
  tokenDigest String @unique
  factorVersion Int
  userVersion Int
  failures Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  enrollmentId String? @unique @db.Uuid
  pendingSecret String?
  @@index([expiresAt])
}

model MfaFactor {
  userId String @id @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  encryptedSecret String
  version Int @default(1)
  lastUsedStep BigInt @default(-1)
}

model RecoveryCode {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  digest String @unique
  consumedAt DateTime? @db.Timestamptz(3)
}

model AdminSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user AdminUser @relation(fields:[userId], references:[id], onDelete:Restrict)
  tokenDigest String @unique
  mfaVerified Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  idleExpiresAt DateTime @db.Timestamptz(3)
  absoluteExpiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([userId,revokedAt])
}

model IdentityRateLimit {
  key String @id
  count Int @default(0)
  windowStart DateTime @db.Timestamptz(3)
  blockedUntil DateTime? @db.Timestamptz(3)
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String
  objectId String?
  result String
  requestId String
  reason String?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([occurredAt])
}

model AdminInvitation {
  id String @id @db.Uuid
  userId String @unique @db.Uuid
  user AdminUser @relation("InvitationTarget", fields: [userId], references: [id], onDelete: Restrict)
  inviterId String @db.Uuid
  inviter AdminUser @relation("InvitationIssuer", fields: [inviterId], references: [id], onDelete: Restrict)
  version Int @default(1)
  status String @default("pending")
  tokenDigest String @unique
  expiresAt DateTime @db.Timestamptz(3)
  lastSentAt DateTime @db.Timestamptz(3)
  sendWindowStartedAt DateTime @db.Timestamptz(3)
  sendsInWindow Int
  notificationJobId String? @db.Uuid
  resendReceipts Json @default("{}")
  notificationJobs IdentityNotificationJob[]
}

model AdminPasswordReset {
  id String @id @db.Uuid
  userId String @unique @db.Uuid
  user AdminUser @relation("PasswordResetTarget", fields: [userId], references: [id], onDelete: Restrict)
  version Int @default(1)
  status String @default("pending")
  tokenDigest String @unique
  expiresAt DateTime @db.Timestamptz(3)
  requestedAt DateTime @db.Timestamptz(3)
  notificationJobId String? @db.Uuid
  notificationJobs IdentityNotificationJob[]
}

// One queue row per deliverable secret. Exactly one target reference is set;
// the database enforces that pairing with a CHECK constraint in the migration.
model IdentityNotificationJob {
  id String @id @db.Uuid
  kind String @default("invitation")
  invitationId String? @db.Uuid
  passwordResetId String? @db.Uuid
  targetVersion Int
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  lastErrorCode String?
  sentAt DateTime? @db.Timestamptz(3)
  invitation AdminInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  passwordReset AdminPasswordReset? @relation(fields: [passwordResetId], references: [id], onDelete: Restrict)
  encryptedPayload String?
  expiresAt DateTime @db.Timestamptz(3)
  status String @default("pending")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([status, expiresAt])
  @@index([status, availableAt, leaseExpiresAt])
}

// 单实例单店铺：id 固定为 1，用 CHECK 约束在数据库层阻止第二个店铺行。
model StoreConfig {
  id Int @id @default(1)
  displayName String
  locales String[]
  defaultLocale String
  baseCurrency String
  timezone String
  featureFlags Json @default("{}")
  logoMediaId String? @db.Uuid
  logoMedia MediaAsset? @relation("StoreLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  faviconMediaId String? @db.Uuid
  faviconMedia MediaAsset? @relation("StoreFavicon", fields: [faviconMediaId], references: [id], onDelete: Restrict)
  /// 首次产生真实交易后锁定基础币种，避免历史订单与本位币不一致。
  tradingStartedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  markets MarketProfile[]
  reviews MarketReviewRecord[]
}

model MarketProfile {
  id String @id @default(uuid()) @db.Uuid
  marketCode String @unique
  enabled Boolean @default(false)
  eligibleProductIds String[] @db.Uuid
  reviewStatus String @default("pending")
  reviewValidUntil DateTime? @db.Timestamptz(3)
  storeConfigId Int @default(1)
  storeConfig StoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// 审核是追加历史：记录客户提供的依据，不做法规判断，也不能被改写。
model MarketReviewRecord {
  id String @id @default(uuid()) @db.Uuid
  storeConfigId Int @default(1)
  storeConfig StoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  marketCode String
  decision String
  evidenceReference String
  reason String
  reviewedBy String @db.Uuid
  reviewedAt DateTime @db.Timestamptz(3)
  validUntil DateTime? @db.Timestamptz(3)
  storeConfigVersion Int
  @@index([marketCode, reviewedAt])
}

// ---- 商品目录（M03）---------------------------------------------------------
// 多语言按翻译实体管理；金额为整数最小货币单位并带币种；SKU 全店唯一。
// 图片只保存媒体引用与顺序，媒体对象本身由媒体模块（M02）管理。

// 媒体（M02）：对象存储保存二进制，这里只保存元数据与校验摘要。
// status 在确认上传前为 pending，确认并核对摘要后转 ready；前台只读 ready。
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  objectKey String @unique
  contentType String
  sizeBytes Int
  /// 摘要与尺寸在确认上传后写入；pending 行允许为空。
  sha256 String?
  width Int?
  height Int?
  originalFileName String
  status String @default("pending")
  uploadedBy String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  productMedia ProductMedia[]
  brands Brand[]
  storeLogos StoreConfig[] @relation("StoreLogo")
  storeFavicons StoreConfig[] @relation("StoreFavicon")
  @@index([status, createdAt])
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  position Int @default(0)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  translations CategoryTranslation[]
  products ProductCategory[]
}

model CategoryTranslation {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale String
  name String
  slug String?
  description String?
  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model Brand {
  id String @id @default(uuid()) @db.Uuid
  logoMediaId String? @db.Uuid
  logoMedia MediaAsset? @relation(fields: [logoMediaId], references: [id], onDelete: Restrict)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  translations BrandTranslation[]
  products Product[]
}

model BrandTranslation {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locale String
  name String
  slug String?
  description String?
  @@unique([brandId, locale])
  @@unique([locale, slug])
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  status String @default("draft")
  baseSku String?
  brandId String? @db.Uuid
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  taxClassRef String?
  marketCodes String[]
  /// 未来时间表示定时发布；status 仍为 draft，直到发布时刻生效。
  publishedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  translations ProductTranslation[]
  variants ProductVariant[]
  media ProductMedia[]
  attributes ProductAttribute[]
  categories ProductCategory[]
  @@index([status, createdAt])
}

model ProductTranslation {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale String
  name String
  slug String
  shortDescription String?
  description String?
  seoTitle String?
  seoDescription String?
  @@unique([productId, locale])
  @@unique([locale, slug])
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku String @unique
  optionValues Json
  priceMinor Int
  compareAtMinor Int?
  currency String
  status String @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  inventory InventoryItem?
  cartItems CartItem[]
  quoteLines CheckoutQuoteLine[]
  orderItems OrderItem[]
  reservations InventoryReservation[]
}

model ProductMedia {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId String @db.Uuid
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position Int
  altByLocale Json @default("{}")
  @@unique([productId, mediaId])
}

model ProductAttribute {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  code String
  value String
  @@unique([productId, code])
}

model ProductCategory {
  productId String @db.Uuid
  categoryId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@id([productId, categoryId])
}

// 库存先只保存数量，变更流水由 M12 引入；当前没有写入库存的接口。
model InventoryItem {
  id String @id @default(uuid()) @db.Uuid
  variantId String @unique @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand Int @default(0)
  reserved Int @default(0)
}

// ---- 购物车与结账（M06）-----------------------------------------------------
// 游客购物袋只认 cookie 里的随机 token：库里存摘要，泄库也拿不到可用 token。
// 报价是不可变快照，行数据与联系/地址/配送快照一起冻结，下单只认报价版本。

model GuestCart {
  id String @id @default(uuid()) @db.Uuid
  tokenDigest String @unique
  status String @default("active")
  currency String
  marketCode String?
  locale String?
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items CartItem[]
  quotes CheckoutQuote[]
  orders ShopOrder[]
  @@index([status, expiresAt])
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart GuestCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([cartId, variantId])
}

// 配送区按国家/区域划分；费率绑定到区，首期只支持固定费与金额门槛免邮。
model ShippingZone {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  nameByLocale Json
  countryCodes String[]
  regionCodes String[]
  priority Int @default(0)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  rates ShippingRateZone[]
}

model ShippingRate {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  nameByLocale Json
  fixedFeeMinor Int
  freeAboveMinor Int?
  currency String
  estimatedMinDays Int?
  estimatedMaxDays Int?
  codEnabled Boolean @default(false)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  zones ShippingRateZone[]
  orders ShopOrder[]
}

model ShippingRateZone {
  rateId String @db.Uuid
  zoneId String @db.Uuid
  rate ShippingRate @relation(fields: [rateId], references: [id], onDelete: Cascade)
  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  @@id([rateId, zoneId])
}

model CheckoutQuote {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart GuestCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  status String @default("active")
  version Int @default(1)
  locale String
  marketCode String
  currency String
  contact Json
  shippingAddress Json
  shippingMethodId String @db.Uuid
  shippingMethodSnapshot Json
  subtotalMinor Int
  discountMinor Int
  shippingMinor Int
  taxMinor Int
  totalMinor Int
  couponCode String?
  couponSummary Json?
  ruleVersions Json
  warnings Json
  policyAcceptances Json
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lines CheckoutQuoteLine[]
  order ShopOrder?
  @@index([cartId, status])
}

model CheckoutQuoteLine {
  id String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  quote CheckoutQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sku String
  productName String
  variantName String?
  quantity Int
  unitPriceMinor Int
  lineSubtotalMinor Int
  lineDiscountMinor Int
  lineTotalMinor Int
  @@unique([quoteId, variantId])
}

// 订单只由报价生成：金额、联系、地址、配送、优惠全部来自快照，不接受客户端金额。
model ShopOrder {
  id String @id @default(uuid()) @db.Uuid
  publicOrderNumber String @unique
  idempotencyKey String @unique
  requestDigest String
  quoteId String @unique @db.Uuid
  quote CheckoutQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  cartId String? @db.Uuid
  cart GuestCart? @relation(fields: [cartId], references: [id], onDelete: SetNull)
  shippingRateId String? @db.Uuid
  shippingRate ShippingRate? @relation(fields: [shippingRateId], references: [id], onDelete: Restrict)
  orderStatus String
  paymentStatus String
  fulfillmentStatus String @default("unfulfilled")
  currency String
  subtotalMinor Int
  discountMinor Int
  shippingMinor Int
  taxMinor Int
  totalMinor Int
  locale String
  marketCode String
  contact Json
  shippingAddress Json?
  shippingMethodSnapshot Json
  couponSnapshot Json?
  customerNote String?
  paymentMethodCode String
  policyAcceptances Json
  cancelledAt DateTime? @db.Timestamptz(3)
  cancelReasonCode String?
  cancelReason String?
  customerNotified Boolean @default(false)
  placedAt DateTime @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items OrderItem[]
  events OrderStatusEvent[]
  reservations InventoryReservation[]
  notes OrderNote[]
  actions OrderAction[]
  shipments Shipment[]
  addressChanges OrderAddressChange[]
  @@index([orderStatus, placedAt])
  @@index([placedAt])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String? @db.Uuid
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku String
  productName String
  variantName String?
  quantity Int
  unitPriceMinor Int
  lineSubtotalMinor Int
  lineDiscountMinor Int
  lineTotalMinor Int
  shipmentItems ShipmentItem[]
  @@index([orderId])
}

// ---- 订单履约（M07）----------------------------------------------------------
// 状态只由显式 action 推进：备注、包裹、发货、签收各写各的记录，不给“直接改状态”的入口。
// 幂等表把后台写操作的 Idempotency-Key 落库，重放时返回同一结果而不是重复扣库存。

model OrderNote {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  note String
  authorId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

model OrderAction {
  id String @id @default(uuid()) @db.Uuid
  idempotencyKey String @unique
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action String
  requestDigest String
  objectId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId])
}

model Shipment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status String @default("created")
  carrierCode String?
  carrierName String?
  trackingNumber String?
  note String?
  dispatchedAt DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  evidenceRef String?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items ShipmentItem[]
  @@index([orderId, createdAt])
}

model ShipmentItem {
  id String @id @default(uuid()) @db.Uuid
  shipmentId String @db.Uuid
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String @db.Uuid
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity Int
  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model OrderAddressChange {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousAddress Json?
  newAddress Json
  shippingMinorBefore Int
  shippingMinorAfter Int
  totalMinorBefore Int
  totalMinorAfter Int
  customerConfirmationRef String?
  actorId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

// 预留与订单同事务写入：库存不足时没有任何一行能落库。
model InventoryReservation {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity Int
  status String @default("active")
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([orderId, variantId])
  @@index([status, expiresAt])
}

model OrderStatusEvent {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus String
  reason String?
  actorType String @default("customer")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}
