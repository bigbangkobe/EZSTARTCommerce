HOST=127.0.0.1
PORT=3001
# Leave DATABASE_URL unset for health-only mode. Supply an isolated PostgreSQL 18 database to enable identity.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ezstart
# APP_ORIGIN=https://localhost.example
# INSTANCE_ID=replace-with-a-generated-uuid
# IDENTITY_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
# BOOTSTRAP_TOKEN=replace-with-32-random-bytes-encoded-as-base64url
# NODE_ENV=development
# Never commit actual credentials. Cookies are Secure: use HTTPS for browser login.

# SMTP delivery worker. Credentials are per-instance secrets; TLS is mandatory.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=replace-with-provider-user
# SMTP_PASSWORD=replace-with-provider-secret
# SMTP_FROM=store@example.com
# Next.js server-only API origin. Production public APP_ORIGIN must use HTTPS.
# API_INTERNAL_ORIGIN=http://127.0.0.1:3001
# Client IP trust: 0 (default) trusts only the direct peer address. Behind one reverse proxy
# (Caddy, ALB) set it to the hop count, otherwise every visitor shares one rate-limit bucket
# and cart writes / member login codes start returning 429 across the whole shop.
# TRUSTED_PROXY_HOPS=1
